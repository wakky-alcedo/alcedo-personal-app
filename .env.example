# Cloudflare Tunnel token (from Cloudflare Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=your-token-here

# API key for X-Api-Key authentication (change from default for production)
API_KEY=dev-local-key

# Public URL of the backend as seen from the browser
# e.g. https://api.your-domain.com  (via Cloudflare Tunnel)
VITE_SERVER_URL=http://localhost:8787
